# Committed template. Copy to backend/.env before anything else:
#   cp .env.example .env
#
# Two consumers read this file:
#   - docker compose, automatically, for the two service definitions
#   - the Rails app, via dotenv-rails, in development and test only
#
# Nothing in the codebase carries a fallback, so every name below must be set —
# a missing one fails loudly at boot rather than silently using a default.

# --- Postgres ----------------------------------------------------------------
# POSTGRES_PORT is the published host port and the port Rails connects on: with
# the app running natively there is only one address, so there is only one name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Puma's thread count and Active Record's connection pool size. Deliberately
# small — the naive redirect's queue behaviour under load is a thing the
# baseline measurement is meant to expose, not something to tune away.
RAILS_MAX_THREADS=5

# --- Redis -------------------------------------------------------------------
# db0 is the read cache and click buffer; db1 is the Sidekiq broker. Splitting
# them keeps `allkeys-lru` from evicting queued jobs (research.md D9,
# Principle IV).
#
# REDIS_HOST_PORT is what compose publishes; the two URLs are what the app dials.
# They must agree — compose cannot read a port out of a URL.
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
SIDEKIQ_REDIS_URL=redis://localhost:6380/1

# --- Application -------------------------------------------------------------
# The domain short codes are served from. A placeholder (design.md); it appears
# here and in the app shell header and nowhere else.
SHORT_DOMAIN=snp.to

# Where the dashboard is served. The short domain's not-found and safety pages
# link across to it; nothing else in the backend does.
APP_URL=http://localhost:3000
