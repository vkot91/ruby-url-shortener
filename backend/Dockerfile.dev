# Development image: source is bind-mounted, so only the gems are baked in.
# backend/Dockerfile (Rails' generated one) remains the production build.
FROM ruby:3.4.8-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential libpq-dev git curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /rails

# Gems live outside /rails, which is bind-mounted over at run time, and outside
# the image's default /usr/local/bundle so compose can mount a named volume here
# without shadowing bundler's own binstubs. The volume is seeded from this layer
# on first `up`; after that `bundle check || bundle install` in the compose
# command tops it up whenever Gemfile.lock moves, so a gem change needs no rebuild.
ENV BUNDLE_PATH=/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3001
CMD ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3001"]
