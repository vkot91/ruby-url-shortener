# Committed template. Copy to frontend/.env.local before running `pnpm dev`:
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically, so unlike the backend there is no
# dotenv dependency and nothing to source by hand.
#
# NEXT_PUBLIC_ is not decoration: Next.js inlines only prefixed names into the
# browser bundle, and this one has to reach the browser because the dashboard
# calls the API from the client. Never put a secret behind that prefix.

# Where the Rails API listens. Port 3001 so it does not collide with the Next.js
# dev server on 3000.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Where the session cookies are scoped, so the API on the other origin receives
# them. Leave unset locally: cookies are not isolated by port (RFC 6265 §8.5),
# so a host-only cookie for `localhost` already reaches the API on :3001.
#
# In production the dashboard and the API must be siblings under one registrable
# domain and this names it — for app.snip.to and api.snip.to, set:
#   SESSION_COOKIE_DOMAIN=.snip.to
# The short domain is deliberately outside that family, so no session cookie is
# ever sent with a redirect.
#
# No NEXT_PUBLIC_ prefix: this is read on the server only, and the cookies it
# scopes are httpOnly.
# SESSION_COOKIE_DOMAIN=
