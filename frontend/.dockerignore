# Build context exclusions for frontend/Dockerfile.dev. node_modules is the
# important one: copying a host-built tree into the image both bloats the
# context and risks shipping darwin-native binaries into a linux container.
node_modules/
.next/
out/
build/
coverage/
playwright-report/
test-results/

.git/
.gitignore
Dockerfile*
.dockerignore

.env*
!.env.example
*.log
.DS_Store
.idea/
.vscode/
