# Development image: source is bind-mounted and node_modules is masked by an
# anonymous volume, so the container keeps its own linux-built binaries.
FROM node:22.14.0-slim

# pnpm is pinned by the "packageManager" field in package.json; corepack reads
# it, so the container and the host always run the same version.
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

EXPOSE 3000
CMD ["pnpm", "dev"]
