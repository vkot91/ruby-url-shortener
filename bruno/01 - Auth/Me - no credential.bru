meta {
  name: Me - no credential
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: none
}

tests {
  test("refuses an anonymous caller", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("says unauthenticated, not token_expired", function () {
    expect(res.body.error.code).to.equal("unauthenticated");
  });
}

docs {
  `auth: none` is the assertion. Authentication is declared once at the
  collection level, so a request that must go out without a credential has to
  opt out of it explicitly — and that opt-out is the thing being tested.

  The distinction between the two 401 codes is the point of this pair. The
  browser client treats them identically now, refreshing on either, because only
  the BFF can see whether a refresh token exists — but Rails still has to
  distinguish them, because a non-browser client with no BFF in front of it has
  nothing else to go on.
}
