meta {
  name: Sign in
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/sessions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("accessToken", res.body.access_token);
    bru.setVar("refreshToken", res.body.refresh_token);
  }
}

tests {
  test("opens a session", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.access_token).to.be.a("string").and.not.be.empty;
  });

  test("issues a refresh token", function () {
    expect(res.body.refresh_token).to.be.a("string").and.not.be.empty;
  });

  test("expires the access token in fifteen minutes", function () {
    expect(res.body.expires_in).to.equal(900);
  });
}

docs {
  FR-001. One sign-in opens one refresh-token family.

  ## The account

  `dev@snip.test` / `development password`, from the `email` and `password`
  variables in the Local environment. It is created by `backend/db/seeds.rb`,
  which runs automatically when the database is created and can be re-run at
  any time:

  ```sh
  docker compose exec backend bin/rails db:seed
  ```

  The credentials are committed on purpose: they are a development fixture, not
  a secret, and the point of them is to be the same on every machine and after
  every `db:reset`. The seed refuses to run in production for the obvious
  reason.

  This is the entry point to the collection. Everything in `02 - Links` and
  `03 - Redirect` needs an access token and nothing more, so running this one
  request is enough — `Register` exists to test registration, not to set the
  collection up.

  ## Limits

  Two limiters guard this endpoint (FR-036): 10/hour per origin, and 5/hour per
  email address so a password list cannot be spread across many origins against
  one account. The per-address one counts this seeded address like any other, so
  `Sign in - wrong password` is the request that will exhaust it first.
}
