auth {
  mode: bearer
}

auth:bearer {
  token: {{accessToken}}
}

docs {
  # Snip API

  Manual test collection for the URL shortener backend. Every request in here
  is a request the backend actually answers today; folders are numbered in the
  order they are meant to be run, and the auth folder seeds the variables the
  rest of the collection depends on.

  See README.md next to this file for the run order and the variable contract.
}
