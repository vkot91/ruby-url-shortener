meta {
  name: Create link - no name
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/links
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "destination_url": "https://www.ruby-lang.org/en/documentation/"
  }
}

tests {
  test("the name is optional", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.name).to.equal(null);
  });
}

docs {
  `name` is optional, and an empty string is stored as null rather than as an
  empty label — `name.presence` in Links::Creator. Try sending `"name": ""` and
  watch it come back null.
}
