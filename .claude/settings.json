{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "jq -r '.tool_input.command' | grep -Eq -- '(^|[[:space:]])(--no-verify|-n)([[:space:]]|$)' || { \"$CLAUDE_PROJECT_DIR/hooks/pre-commit\" >&2 || exit 2; }",
            "statusMessage": "Running RuboCop...",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
