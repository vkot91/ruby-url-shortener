# Committed template. Copy to .env before anything else: `cp .env.example .env`
# Nothing in the codebase carries a fallback, so every name below must be set —
# a missing one fails loudly at boot rather than silently using a default.

# --- Published host ports, read by docker-compose.yml ------------------------
# Non-default on purpose: 5432 and 6379 are commonly already taken. The ports
# inside the compose network are unchanged.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Host-side tooling (rspec, k6, rails console outside the containers) -----
# Load before running them: `set -a; source .env; set +a`
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RAILS_MAX_THREADS=5
REDIS_URL=redis://localhost:6380/0
SIDEKIQ_REDIS_URL=redis://localhost:6380/1

# --- Application ------------------------------------------------------------
# The domain short codes are served from. A placeholder (design.md); it appears
# here and in the app shell header and nowhere else.
SHORT_DOMAIN=snp.to

# Where the dashboard is served. The short domain's not-found and safety pages
# link across to it; nothing else in the backend does.
APP_URL=http://localhost:3000
